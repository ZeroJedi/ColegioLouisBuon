# ==============================================================================
# Colegio Louis Buon Langlais — Configuración de Servidor Web (Hostinger)
# Dominio Oficial Canónico: https://colegiolouisbuonlanglais.com.mx
# ==============================================================================

# 1. Motor de Reescritura Activo
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ─── A. Forzar HTTPS Seguro (301) ──────────────────────────────────────────
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ─── B. Forzar URL Corta sin "www" (Redirección Canónica 301) ───────────────
  # Redirige www.colegiolouisbuonlanglais.com.mx -> colegiolouisbuonlanglais.com.mx
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # ─── C. Redirección Futura para .edu.mx (Preparada) ─────────────────────────
  # Si el colegio apunta colegiolouisbuonlanglais.edu.mx a este mismo hosting,
  # mantendrá la navegación unificada hacia el dominio canónico.
  RewriteCond %{HTTP_HOST} ^(www\.)?colegiolouisbuonlanglais\.edu\.mx$ [NC]
  RewriteRule ^(.*)$ https://colegiolouisbuonlanglais.com.mx/$1 [R=301,L]

  # ─── D. Soporte de Rutas Limpias de Next.js (SSG Static Export) ─────────────
  # Si la petición busca una ruta sin extensión (ej: /contacto), servir /contacto.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # Si la petición es una carpeta, buscar index.html
  DirectoryIndex index.html
</IfModule>

# 2. Compresión Gzip / Deflate (Máximo Rendimiento Lighthouse)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# 3. Políticas de Caché de Navegador (Browser Caching)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML: Sin caché prolongada para reflejar cambios y avisos de inmediato
  ExpiresByType text/html "access plus 0 seconds"

  # Datos y Manifiesto
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/manifest+json "access plus 1 week"

  # Imágenes optimizadas (WebP, PNG, ICO, SVG): 1 año de caché
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"

  # CSS y JavaScript: 1 año (Next.js usa hashes en los nombres de archivo)
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
</IfModule>

# 4. Cabeceras de Seguridad Básica
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
